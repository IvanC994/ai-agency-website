---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import { SITE_URL } from '../../config/site';
import workflowsData from '../../data/workflows.json';

export async function getStaticPaths() {
  return workflowsData.map((workflow) => ({
    params: { workflow: workflow.slug },
    props: { workflow },
  }));
}

const { workflow } = Astro.props;
---

<BaseLayout
  title={`${workflow.title_sr} | RoutineForge`}
  description={`Želite li da implementirate rešenje: ${workflow.title_sr.toLowerCase()}? RoutineForge gradi prilagođene AI sisteme za skaliranje vašeg poslovanja.`}
  canonical={`${SITE_URL}/procesi/${workflow.slug}/`}
  lang="sr"
  enUrl={`${SITE_URL}/workflows/${workflow.slug}/`}
  srUrl={`${SITE_URL}/procesi/${workflow.slug}/`}
>
  <div class="flow-grid-bg min-h-screen">
    <Navbar />
    
    <main class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <section class="py-12 md:py-20 grid lg:grid-cols-[1.2fr_0.8fr] gap-12 items-center">
        <div>
          <SectionHeading 
            title={workflow.title_sr} 
            eyebrow="Automatizacija Procesa" 
            as="h1" 
          />
          <div class="mt-8 max-w-3xl space-y-8">
            <div class="border-l-4 border-slate-200 pl-6">
              <h3 class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-2">Problem</h3>
              <p class="text-lg leading-8 text-slate-700">{workflow.problem_sr}</p>
            </div>
            <div class="border-l-4 border-sky-400 pl-6 bg-gradient-to-r from-sky-50 to-transparent py-4 rounded-r-xl">
              <h3 class="text-xs font-semibold uppercase tracking-widest text-sky-600 mb-2">AI Rešenje</h3>
              <p class="text-lg leading-8 text-slate-900 font-medium">{workflow.solution_sr}</p>
            </div>
            
            <div class="mt-10 flex flex-wrap gap-3">
              <Button href="/sr/#contact">Zakažite besplatnu konsultaciju</Button>
            </div>
          </div>
        </div>
        
        <div class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm">
          <h3 class="font-semibold text-slate-900 text-lg mb-6">Zašto raditi sa nama?</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-sky-100 text-sky-700 text-sm">✓</span>
              <span class="text-sm leading-6 text-slate-600"><strong>Prilagođeno vama:</strong> Ne primoravamo vas na generičke alate. Gradimo sistem prema vašim procesima.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-sky-100 text-sky-700 text-sm">✓</span>
              <span class="text-sm leading-6 text-slate-600"><strong>Povezano:</strong> Sistem direktno komunicira sa vašim postojećim CRM-om, kalendarom ili bazom podataka.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-sky-100 text-sky-700 text-sm">✓</span>
              <span class="text-sm leading-6 text-slate-600"><strong>Pouzdano:</strong> Dizajniramo stroga pravila za prenos na ljudskog agenta kako bi sistem bio 100% bezbedan.</span>
            </li>
          </ul>
        </div>
      </section>
    </main>
    
    <Footer />
  </div>
</BaseLayout>
