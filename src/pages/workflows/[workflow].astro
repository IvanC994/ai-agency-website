---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import { SITE_URL } from '../../config/site';
import workflowsData from '../../data/workflows.json';

export async function getStaticPaths() {
  return workflowsData.map((workflow) => ({
    params: { workflow: workflow.slug },
    props: { workflow },
  }));
}

const { workflow } = Astro.props;
---

<BaseLayout
  title={`${workflow.title_en} | RoutineForge`}
  description={`Looking to ${workflow.title_en.toLowerCase()}? RoutineForge builds custom AI systems to eliminate bottlenecks and scale your operations.`}
  canonical={`${SITE_URL}/workflows/${workflow.slug}/`}
  lang="en"
  enUrl={`${SITE_URL}/workflows/${workflow.slug}/`}
  srUrl={`${SITE_URL}/procesi/${workflow.slug}/`}
>
  <div class="flow-grid-bg min-h-screen">
    <Navbar />
    
    <main class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <section class="py-12 md:py-20 grid lg:grid-cols-[1.2fr_0.8fr] gap-12 items-center">
        <div>
          <SectionHeading 
            title={workflow.title_en} 
            eyebrow="Workflow Automation" 
            as="h1" 
          />
          <div class="mt-8 max-w-3xl space-y-8">
            <div class="border-l-4 border-slate-200 dark:border-slate-700 pl-6">
              <h3 class="text-xs font-semibold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-2">The Problem</h3>
              <p class="text-lg leading-8 text-slate-700 dark:text-slate-200">{workflow.problem_en}</p>
            </div>
            <div class="border-l-4 border-sky-400 pl-6 bg-gradient-to-r from-sky-50 to-transparent py-4 rounded-r-xl">
              <h3 class="text-xs font-semibold uppercase tracking-widest text-sky-600 mb-2">The AI Solution</h3>
              <p class="text-lg leading-8 text-slate-900 dark:text-white font-medium">{workflow.solution_en}</p>
            </div>
            
            <div class="mt-10 flex flex-wrap gap-3">
              <Button href="/#contact">Discuss this workflow</Button>
            </div>
          </div>
        </div>
        
        <div class="rounded-[2rem] border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-8 shadow-sm dark:shadow-none">
          <h3 class="font-semibold text-slate-900 dark:text-white text-lg mb-6">Why automate with RoutineForge?</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-sky-100 text-sky-700 dark:text-sky-300 text-sm">✓</span>
              <span class="text-sm leading-6 text-slate-600 dark:text-slate-300"><strong>Custom built:</strong> We don't force you into a generic SaaS tool. We build around your exact process.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-sky-100 text-sky-700 dark:text-sky-300 text-sm">✓</span>
              <span class="text-sm leading-6 text-slate-600 dark:text-slate-300"><strong>Connected:</strong> It talks to the CRM, calendar, or database you already use.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-sky-100 text-sky-700 dark:text-sky-300 text-sm">✓</span>
              <span class="text-sm leading-6 text-slate-600 dark:text-slate-300"><strong>Reliable:</strong> We design strict human handoff rules so the AI never goes rogue.</span>
            </li>
          </ul>
        </div>
      </section>
    </main>
    
    <Footer />
  </div>
</BaseLayout>
