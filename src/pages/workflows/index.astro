---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { SITE_URL } from '../../config/site';
import workflowsData from '../../data/workflows.json';
---

<BaseLayout
  title="AI Workflow Automation | RoutineForge"
  description="Explore the business processes and workflows that RoutineForge can automate using custom AI systems."
  canonical={`${SITE_URL}/workflows/`}
  lang="en"
  enUrl={`${SITE_URL}/workflows/`}
  srUrl={`${SITE_URL}/procesi/`}
>
  <div class="flow-grid-bg min-h-screen">
    <Navbar />
    
    <main class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <SectionHeading title="Automated Workflows" eyebrow="Business Processes" as="h1" />
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300 max-w-2xl">We build custom AI systems to eliminate your most repetitive business bottlenecks. Explore the processes we automate.</p>
      
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {workflowsData.map((workflow) => (
          <a 
            href={`/workflows/${workflow.slug}/`} 
            class="group flex flex-col justify-between rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none transition hover:border-sky-300 hover:shadow-md dark:shadow-none"
          >
            <div>
              <h3 class="font-semibold text-slate-900 dark:text-white group-hover:text-sky-700 dark:text-sky-300">{workflow.title_en}</h3>
              <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300 line-clamp-3">{workflow.problem_en}</p>
            </div>
            <div class="mt-4 flex items-center text-sm font-medium text-sky-600">
              Read more <span class="ml-1 opacity-0 transition group-hover:translate-x-1 group-hover:opacity-100">→</span>
            </div>
          </a>
        ))}
      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>
