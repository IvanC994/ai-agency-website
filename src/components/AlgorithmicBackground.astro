---
// High-tech algorithmic background using p5.js
---

<div id="algorithmic-bg" class="fixed inset-0 z-[-1] pointer-events-none opacity-[0.85]"></div>

<script is:inline>
  const algorithmicBackground = (p) => {
    let particles = [];
    const numParticles = Math.min(Math.floor(window.innerWidth / 15), 100); // Scale with screen size
    const connectionDistance = 140;
    
    // Seeded randomness for consistency
    const seed = 948271;

    p.setup = () => {
      let canvas = p.createCanvas(p.windowWidth, p.windowHeight);
      canvas.parent('algorithmic-bg');
      p.pixelDensity(1); // Keeps performance high
      p.frameRate(30); // 30fps is plenty for a smooth background
      
      p.randomSeed(seed);
      p.noiseSeed(seed);
      
      for(let i = 0; i < numParticles; i++) {
        particles.push(new Particle());
      }
    };
    
    p.draw = () => {
      p.clear(); // Transparent background so the site's bg color shows through
      
      // Update and draw particles
      for(let i = 0; i < particles.length; i++) {
        particles[i].update();
        particles[i].display();
        
        // Draw connections (Emergent network)
        for(let j = i + 1; j < particles.length; j++) {
          let d = p.dist(particles[i].pos.x, particles[i].pos.y, particles[j].pos.x, particles[j].pos.y);
          if(d < connectionDistance) {
            // Opacity scales based on distance
            let alpha = p.map(d, 0, connectionDistance, 120, 0);
            
            // Subtle blue/cyan tech connections
                        const isDark = document.documentElement.classList.contains("dark");
            if (isDark) {
              p.stroke(56, 189, 248, alpha * 2); // sky-400 with brighter alpha
            } else {
              p.stroke(14, 165, 233, alpha);
            } 
            p.strokeWeight(1);
            p.line(particles[i].pos.x, particles[i].pos.y, particles[j].pos.x, particles[j].pos.y);
          }
        }
      }
    };
    
    p.windowResized = () => {
      p.resizeCanvas(p.windowWidth, p.windowHeight);
    };
    
    class Particle {
      constructor() {
        this.pos = p.createVector(p.random(p.width), p.random(p.height));
        // Slow organic movement
        this.vel = p.createVector(p.random(-0.3, 0.3), p.random(-0.3, 0.3)); 
        this.size = p.random(1.5, 3.5);
        this.baseAlpha = p.random(100, 200);
      }
      
      update() {
        // Add subtle perlin noise to movement for organic feel (Quantum Harmonics / Field Dynamics)
        let n = p.noise(this.pos.x * 0.005, this.pos.y * 0.005, p.frameCount * 0.001);
        let angle = p.map(n, 0, 1, 0, p.TWO_PI);
        
        this.vel.x += p.cos(angle) * 0.01;
        this.vel.y += p.sin(angle) * 0.01;
        
        // Limit speed
        this.vel.limit(0.5);
        
        this.pos.add(this.vel);
        
        // Wrap around edges gracefully instead of harsh bounce
        if(this.pos.x < -50) this.pos.x = p.width + 50;
        if(this.pos.x > p.width + 50) this.pos.x = -50;
        if(this.pos.y < -50) this.pos.y = p.height + 50;
        if(this.pos.y > p.height + 50) this.pos.y = -50;
      }
      
      display() {
        p.noStroke();
                const isDark = document.documentElement.classList.contains("dark");
        if (isDark) {
          p.fill(125, 211, 252, Math.min(this.baseAlpha * 1.5, 255)); // sky-300
        } else {
          p.fill(2, 132, 199, this.baseAlpha); // Tailwind sky-600
        }
        p.circle(this.pos.x, this.pos.y, this.size);
      }
    }
  };
  
    let p5Initialized = false;
  
  const initAlgorithmicBackground = () => {
    if (p5Initialized) return;
    
    const container = document.getElementById("algorithmic-bg");
    if (container) container.innerHTML = "";
    
    if (typeof p5 !== "undefined") {
      p5Initialized = true;
      new p5(algorithmicBackground);
      return;
    }
    
    if (document.querySelector("script[src*=\"p5.min.js\"]")) return;
    
    const script = document.createElement("script");
    script.src = "https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.7.0/p5.min.js";
    script.onload = () => {
      p5Initialized = true;
      if (window.requestIdleCallback) {
        window.requestIdleCallback(() => new p5(algorithmicBackground));
      } else {
        setTimeout(() => new p5(algorithmicBackground), 200);
      }
    };
    document.body.appendChild(script);
  };
  
  document.addEventListener("astro:page-load", () => {
    p5Initialized = false; 
    initAlgorithmicBackground();
  });
  window.addEventListener("DOMContentLoaded", initAlgorithmicBackground);
  window.addEventListener("load", initAlgorithmicBackground);
</script>
