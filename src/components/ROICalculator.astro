---
const { 
  lang = 'en',
  eyebrow,
  title,
  description,
  currency,
  inquiriesLabel,
  avgValueLabel,
  adminHoursLabel,
  recoveredLeadsLabel,
  extraRevenueLabel,
  hoursSavedLabel,
  disclaimer
} = Astro.props;

const isSr = lang === 'sr';

const defaults = isSr
  ? {
      eyebrow: 'ROI kalkulator',
      title: 'Vidite koliko bi vam automatizacija vredela',
      description: 'Pomerite klizače da odgovaraju vašem poslovanju i vidite procenu na osnovu tipičnih rezultata RoutineForge klijenata.',
      currency: '€',
      inquiriesLabel: 'Upiti klijenata mesečno',
      avgValueLabel: 'Prosečna vrednost po novom klijentu',
      adminHoursLabel: 'Sati nedeljno na administraciji',
      recoveredLeadsLabel: 'Povraćeni potencijalni klijenti mesečno',
      extraRevenueLabel: 'Procenjeni dodatni mesečni prihod',
      hoursSavedLabel: 'Ušteđeno sati nedeljno',
      disclaimer: 'Samo procene, na osnovu tipičnih rezultata za klijente. Stvarni rezultati variraju u zavisnosti od poslovanja.'
    }
  : {
      eyebrow: 'ROI calculator',
      title: 'See what automation could be worth to your business',
      description: 'Drag the sliders to match your business, and see a live estimate based on typical RoutineForge client outcomes.',
      currency: '$',
      inquiriesLabel: 'Customer inquiries per month',
      avgValueLabel: 'Average value per booked customer',
      adminHoursLabel: 'Hours/week spent on admin work',
      recoveredLeadsLabel: 'Recovered leads per month',
      extraRevenueLabel: 'Estimated added monthly revenue',
      hoursSavedLabel: 'Hours saved per week',
      disclaimer: 'Estimates only, based on typical outcomes for RoutineForge clients. Actual results vary by business.'
    };

const content = {
  eyebrow: eyebrow || defaults.eyebrow,
  title: title || defaults.title,
  description: description || defaults.description,
  currency: currency || defaults.currency,
  inquiriesLabel: inquiriesLabel || defaults.inquiriesLabel,
  avgValueLabel: avgValueLabel || defaults.avgValueLabel,
  adminHoursLabel: adminHoursLabel || defaults.adminHoursLabel,
  recoveredLeadsLabel: recoveredLeadsLabel || defaults.recoveredLeadsLabel,
  extraRevenueLabel: extraRevenueLabel || defaults.extraRevenueLabel,
  hoursSavedLabel: hoursSavedLabel || defaults.hoursSavedLabel,
  disclaimer: disclaimer || defaults.disclaimer,
};

---

<div class="rounded-[2rem] border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-8 shadow-sm dark:shadow-none sm:p-10" data-roi-root data-currency={content.currency}>
  <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
    <div>
      <div class="max-w-2xl">
        <p class="inline-flex rounded-full border border-sky-200 bg-sky-50 dark:bg-sky-900/30 px-3 py-1 text-sm font-semibold text-sky-700 dark:text-sky-300">{content.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 dark:text-white">{content.title}</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">{content.description}</p>
      </div>

      <div class="mt-10 space-y-7">
      <div>
        <div class="flex items-baseline justify-between">
          <label for="roi-inquiries" class="text-sm font-semibold text-slate-700 dark:text-slate-200">{content.inquiriesLabel}</label>
          <span data-roi-inquiries-value class="text-sm font-semibold text-slate-950 dark:text-white">300</span>
        </div>
        <input id="roi-inquiries" data-roi-input="inquiries" type="range" min="50" max="1000" step="10" value="300" class="mt-3 h-2 w-full cursor-pointer appearance-none rounded-full bg-slate-200 accent-sky-500" />
      </div>

      <div>
        <div class="flex items-baseline justify-between">
          <label for="roi-value" class="text-sm font-semibold text-slate-700 dark:text-slate-200">{content.avgValueLabel}</label>
          <span data-roi-value-value class="text-sm font-semibold text-slate-950 dark:text-white">{content.currency}150</span>
        </div>
        <input id="roi-value" data-roi-input="avgValue" type="range" min="20" max="1000" step="10" value="150" class="mt-3 h-2 w-full cursor-pointer appearance-none rounded-full bg-slate-200 accent-sky-500" />
      </div>

      <div>
        <div class="flex items-baseline justify-between">
          <label for="roi-hours" class="text-sm font-semibold text-slate-700 dark:text-slate-200">{content.adminHoursLabel}</label>
          <span data-roi-hours-value class="text-sm font-semibold text-slate-950 dark:text-white">10</span>
        </div>
        <input id="roi-hours" data-roi-input="adminHours" type="range" min="1" max="40" step="1" value="10" class="mt-3 h-2 w-full cursor-pointer appearance-none rounded-full bg-slate-200 accent-sky-500" />
      </div>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
      <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 p-6">
        <p data-roi-output="recoveredLeads" class="text-3xl font-semibold text-slate-950 dark:text-white">75</p>
        <p class="mt-2 text-sm font-medium text-slate-600 dark:text-slate-300">{content.recoveredLeadsLabel}</p>
      </div>
      <div class="rounded-2xl border border-sky-200 dark:border-slate-700/60 bg-sky-50 dark:bg-slate-900/50 p-6">
        <p data-roi-output="extraRevenue" class="text-3xl font-semibold text-sky-700 dark:text-sky-300">{content.currency}2,250</p>
        <p class="mt-2 text-sm font-medium text-slate-600 dark:text-slate-300">{content.extraRevenueLabel}</p>
      </div>
      <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 p-6">
        <p data-roi-output="hoursSaved" class="text-3xl font-semibold text-slate-950 dark:text-white">7.0</p>
        <p class="mt-2 text-sm font-medium text-slate-600 dark:text-slate-300">{content.hoursSavedLabel}</p>
      </div>
    </div>
  </div>

  <p class="mt-8 text-xs text-slate-400">{content.disclaimer}</p>
</div>

<script>
  document.querySelectorAll('[data-roi-root]').forEach((root) => {
    const currency = root.getAttribute('data-currency') || '$';
    const inputs = {
      inquiries: root.querySelector('[data-roi-input="inquiries"]'),
      avgValue: root.querySelector('[data-roi-input="avgValue"]'),
      adminHours: root.querySelector('[data-roi-input="adminHours"]')
    };
    const valueDisplays = {
      inquiries: root.querySelector('[data-roi-inquiries-value]'),
      avgValue: root.querySelector('[data-roi-value-value]'),
      adminHours: root.querySelector('[data-roi-hours-value]')
    };
    const outputs = {
      recoveredLeads: root.querySelector('[data-roi-output="recoveredLeads"]'),
      extraRevenue: root.querySelector('[data-roi-output="extraRevenue"]'),
      hoursSaved: root.querySelector('[data-roi-output="hoursSaved"]')
    };

    const formatCurrency = (n) => `${content.currency}${Math.round(n).toLocaleString()}`;

    const recalculate = () => {
      const inquiries = Number(inputs.inquiries.value);
      const avgValue = Number(inputs.avgValue.value);
      const adminHours = Number(inputs.adminHours.value);

      valueDisplays.inquiries.textContent = inquiries.toLocaleString();
      valueDisplays.avgValue.textContent = formatCurrency(avgValue);
      valueDisplays.adminHours.textContent = adminHours.toString();

      const recoveredLeads = Math.round(inquiries * 0.25);
      const extraRevenue = recoveredLeads * avgValue * 0.2;
      const hoursSaved = adminHours * 0.7;

      outputs.recoveredLeads.textContent = recoveredLeads.toLocaleString();
      outputs.extraRevenue.textContent = formatCurrency(extraRevenue);
      outputs.hoursSaved.textContent = hoursSaved.toFixed(1);
    };

    Object.values(inputs).forEach((input) => input.addEventListener('input', recalculate));
    recalculate();
  });
</script>
