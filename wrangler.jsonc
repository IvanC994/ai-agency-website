{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-13",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "ai-agency-website",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"ratelimits": [
		{
			"name": "CHAT_SESSION_RATE_LIMITER",
			"namespace_id": "947201",
			"simple": {
				"limit": 6,
				"period": 60
			}
		},
		{
			"name": "CHAT_DUPLICATE_RATE_LIMITER",
			"namespace_id": "947202",
			"simple": {
				"limit": 1,
				"period": 10
			}
		},
		{
			"name": "CHAT_IP_RATE_LIMITER",
			"namespace_id": "947203",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	],
	"observability": {
		"enabled": true
	}
}
